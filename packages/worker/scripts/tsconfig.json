{
  // The recorder runs under Node (tsx), so it gets Node's types; the worker
  // project (../tsconfig.json) deliberately doesn't, so src/ can't use Node APIs.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["./**/*.ts", "../test/fixtures/cases.ts"]
}
